<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

 <xs:complexType name="deviceBaseType">
  <xs:sequence>
   <xs:element name="description"  type="deviceDescriptionType" minOccurs="0" maxOccurs="1"/>
   <xs:element name="pci"          type="pciType"               minOccurs="0" maxOccurs="1"/>
   <xs:element name="irq"          type="irqType"               minOccurs="0" maxOccurs="unbounded"/>
   <xs:element name="memory"       type="deviceMemoryType"      minOccurs="0" maxOccurs="unbounded"/>
   <xs:element name="ioPort"       type="ioPortType"            minOccurs="0" maxOccurs="unbounded"/>
   <xs:element name="capabilities" type="capabilitiesType"      minOccurs="0" maxOccurs="1"/>
  </xs:sequence>
  <xs:attribute name="name" type="nameType" use="required">
   <xs:annotation>
    <xs:documentation>
     Unique device name.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
 </xs:complexType>

 <xs:complexType name="pciAddressType">
  <xs:annotation>
   <xs:documentation>
    PCI Bus, Device, Function triplet (BDF).
   </xs:documentation>
  </xs:annotation>
  <xs:attribute name="bus" type="byteType" use="required">
   <xs:annotation>
    <xs:documentation>
     PCI Bus number.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
  <xs:attribute name="device" type="pciDeviceNumberType" use="required">
   <xs:annotation>
    <xs:documentation>
     PCI Device number.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
  <xs:attribute name="function" type="pciFunctionNumberType" use="required">
   <xs:annotation>
    <xs:documentation>
     PCI Function number.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
 </xs:complexType>

 <xs:simpleType name="pciDeviceNumberType">
  <xs:annotation>
   <xs:documentation>
    PCI Device number.
   </xs:documentation>
  </xs:annotation>
  <xs:restriction base="xs:string">
   <xs:pattern value="16#[0|1][0-9a-fA-F]#"/>
  </xs:restriction>
 </xs:simpleType>

 <xs:simpleType name="pciFunctionNumberType">
  <xs:annotation>
   <xs:documentation>
    PCI Function number.
   </xs:documentation>
  </xs:annotation>
  <xs:restriction base="xs:nonNegativeInteger">
   <xs:maxInclusive value="7"/>
  </xs:restriction>
 </xs:simpleType>

 <xs:complexType name="deviceIdentificationType">
  <xs:annotation>
   <xs:documentation>
    The \texttt{identification} element specifies the PCI device class, device,
    revision and vendor ID.

    For more information, consult the PCI Local Bus Specification,
    "Configuration Space Decoding".

    See line \ref{lst:af-lineref-hw-device-pci-id} in listing
    \ref{lst:annotated-policy} for an example PCI identification.
   </xs:documentation>
  </xs:annotation>
  <xs:attribute name="classcode"  type="word16Type" use="required">
   <xs:annotation>
    <xs:documentation>
     PCI device class.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
  <xs:attribute name="vendorId"   type="word16Type" use="required">
   <xs:annotation>
    <xs:documentation>
     PCI vendor ID.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
  <xs:attribute name="deviceId"   type="word16Type" use="required">
   <xs:annotation>
    <xs:documentation>
     PCI device ID.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
  <xs:attribute name="revisionId" type="byteType"   use="required">
   <xs:annotation>
    <xs:documentation>
     PCI device revision ID.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
 </xs:complexType>

 <xs:complexType name="iommuGroupType">
  <xs:annotation>
   <xs:documentation>
    Devices in the same IOMMU group cannot be properly isolated from each other
    because they may perform inter-device transactions directly, without going
    through the IOMMU.

    Note that this information is currently not used by the toolchain. It is a
    hint to the system integrator whether two devices can be properly isolated
    from each other or not.

    See line \ref{lst:af-lineref-hw-device-iommugroup} in listing
    \ref{lst:annotated-policy} for an example IOMMU group declaration.
   </xs:documentation>
  </xs:annotation>
  <xs:attribute name="id"  type="xs:nonNegativeInteger" use="required">
   <xs:annotation>
    <xs:documentation>
     IOMMU group number.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
 </xs:complexType>

 <xs:simpleType name="barIndexType">
  <xs:restriction base="xs:unsignedInt">
   <xs:minInclusive value="0"/>
   <xs:maxInclusive value="5"/>
  </xs:restriction>
 </xs:simpleType>

 <xs:complexType name="pciBarMemType">
  <xs:annotation>
   <xs:documentation>
    PCI device memory BAR configuration.
   </xs:documentation>
  </xs:annotation>
  <xs:attribute name="index" type="barIndexType" use="required">
   <xs:annotation>
    <xs:documentation>
     PCI Base Address Register index.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
  <xs:attribute name="ref" type="nameType" use="required">
   <xs:annotation>
    <xs:documentation>
     Reference to device memory resource.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
  <xs:attribute name="prefetchable" type="booleanType" use="required">
   <xs:annotation>
    <xs:documentation>
     Indicates whether the device memory region is prefetchable.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
  <xs:attribute name="is64bit" type="booleanType" use="required">
   <xs:annotation>
    <xs:documentation>
     Indicates whether the device memory region can be located anywhere
     in the 64-bit address space.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
 </xs:complexType>

 <xs:complexType name="pciBarPortType">
  <xs:annotation>
   <xs:documentation>
    PCI device I/O port BAR configuration.
   </xs:documentation>
  </xs:annotation>
  <xs:attribute name="index" type="barIndexType" use="required">
   <xs:annotation>
    <xs:documentation>
     PCI Base Address Register index.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
  <xs:attribute name="ref" type="nameType" use="required">
   <xs:annotation>
    <xs:documentation>
     Reference to device I/O port resource.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
 </xs:complexType>

 <xs:complexType name="pciBarROMType">
  <xs:annotation>
   <xs:documentation>
    PCI device expansion ROM configuration.
   </xs:documentation>
  </xs:annotation>
  <xs:attribute name="ref" type="nameType" use="required">
   <xs:annotation>
    <xs:documentation>
     Reference to memory resource.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
 </xs:complexType>

 <xs:complexType name="pciBarsType">
  <xs:annotation>
   <xs:documentation>
    The \texttt{bars} element specifies which device I/O or memory
    resource is associated with which device PCI Base Address Register (BAR)
    or expansion ROM register.
   </xs:documentation>
  </xs:annotation>
  <xs:sequence>
   <xs:choice minOccurs="0" maxOccurs="6">
    <xs:element name="memory"  type="pciBarMemType"  minOccurs="1" maxOccurs="1"/>
    <xs:element name="ioPort" type="pciBarPortType" minOccurs="1" maxOccurs="1"/>
   </xs:choice>
   <xs:element name="rom" type="pciBarROMType"  minOccurs="0" maxOccurs="1"/>
  </xs:sequence>
 </xs:complexType>

 <xs:complexType name="devicesType">
  <xs:annotation>
   <xs:documentation>
    The \texttt{devices} element enumerates all devices provided by the hardware platform.
    Different kinds of devices, be it PCI(e) or legacy (non-PCI), can be
    declared in this section.

    See line \ref{lst:af-lineref-hw-devices} in listing \ref{lst:annotated-policy}
    for an example devices enumeration.
   </xs:documentation>
  </xs:annotation>
  <xs:sequence>
   <xs:element name="device" type="deviceType" minOccurs="0" maxOccurs="unbounded"/>
  </xs:sequence>
  <xs:attribute name="pciConfigAddress" type="word64Type" use="optional">
   <xs:annotation>
    <xs:documentation>
     Physical base address of the PCI configuration space region.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
  <xs:attribute name="pciConfigSize" type="word64Type" use="optional">
   <xs:annotation>
    <xs:documentation>
     Size of the PCI configuration space region.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
 </xs:complexType>

 <xs:complexType name="arm64CpuArchitectureType">
  <xs:annotation>
   <xs:documentation>
    The \texttt{arm64} element specifies the number of CPU cores and the timer
    frequency in kHz.
   </xs:documentation>
  </xs:annotation>
  <xs:sequence>
   <xs:element name="cpu" type="arm64CpuCoreType" minOccurs="1" maxOccurs="unbounded"/>
  </xs:sequence>
  <xs:attribute name="timerFrequency" type="xs:positiveInteger" use="required">
   <xs:annotation>
    <xs:documentation>
     Tick rate of the CPU timer in kHz.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
 </xs:complexType>

 <xs:simpleType name="vmxTimerRateType">
  <xs:annotation>
   <xs:documentation>
    VMX-preemption timer count down rate.
   </xs:documentation>
  </xs:annotation>
  <xs:restriction base="xs:nonNegativeInteger">
   <xs:maxInclusive value="31"/>
  </xs:restriction>
 </xs:simpleType>

 <xs:complexType name="cpuIDValueType">
  <xs:annotation>
   <xs:documentation>
    Register values for a CPUID leaf, see Intel SDM Vol. 2A, "3.2
    Instructions (A-L)", CPUID.
   </xs:documentation>
  </xs:annotation>
  <xs:attribute name="leaf" type="word32Type" use="required">
   <xs:annotation>
    <xs:documentation>
     CPUID leaf.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
  <xs:attribute name="subleaf" type="byteType" use="required">
   <xs:annotation>
    <xs:documentation>
     CPUID subleaf.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
  <xs:attribute name="eax" type="word32Type" use="required">
   <xs:annotation>
    <xs:documentation>
     EAX register value of this leaf.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
  <xs:attribute name="ebx" type="word32Type" use="required">
   <xs:annotation>
    <xs:documentation>
     EBX register value of this leaf.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
  <xs:attribute name="ecx" type="word32Type" use="required">
   <xs:annotation>
    <xs:documentation>
     ECX register value of this leaf.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
  <xs:attribute name="edx" type="word32Type" use="required">
   <xs:annotation>
    <xs:documentation>
     EDX register value of this leaf.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
 </xs:complexType>

 <xs:complexType name="msrValueType">
  <xs:annotation>
   <xs:documentation>
    Register value of an MSR of interest.
   </xs:documentation>
  </xs:annotation>
  <xs:attribute name="address" type="word32Type" use="required">
   <xs:annotation>
    <xs:documentation>
     MSR address.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
  <xs:attribute name="name" type="xs:string" use="required">
   <xs:annotation>
    <xs:documentation>
     Name of MSR.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
  <xs:attribute name="regval" type="word64Type" use="required">
   <xs:annotation>
    <xs:documentation>
     Register value.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
 </xs:complexType>

 <xs:complexType name="capabilitiesType">
  <xs:annotation>
   <xs:documentation>
    List of device capabilities.
   </xs:documentation>
  </xs:annotation>
  <xs:sequence>
   <xs:element name="capability" type="capabilityType" minOccurs="1" maxOccurs="unbounded"/>
  </xs:sequence>
 </xs:complexType>

 <xs:complexType name="capabilityType">
  <xs:annotation>
   <xs:documentation>
    A device \texttt{capability} is used to assign additional information to a
    device. Such a capability might be used by the Muen toolchain to perform
    certain actions on devices with a given capability (e.g. \texttt{ioapic}). A
    system integrator may use this facility to define its own capabilities used
    by custom tools.

    A capability element can have an optional value.

    See line \ref{lst:af-lineref-dev-cap} in listing \ref{lst:annotated-policy}
    for example capabilities.
   </xs:documentation>
  </xs:annotation>
  <xs:simpleContent>
   <xs:extension base="xs:string">
    <xs:attribute name="name" type="xs:string" use="required">
     <xs:annotation>
      <xs:documentation>
       Capability name (free text).
      </xs:documentation>
     </xs:annotation>
    </xs:attribute>
   </xs:extension>
  </xs:simpleContent>
 </xs:complexType>

 <xs:simpleType name="deviceDescriptionType">
  <xs:annotation>
   <xs:documentation>
    Device description (free text).
   </xs:documentation>
  </xs:annotation>
  <xs:restriction base="xs:string"/>
 </xs:simpleType>

 <xs:simpleType name="microcodeRevisionType">
  <xs:annotation>
   <xs:documentation>
    Microcode update revision.
   </xs:documentation>
  </xs:annotation>
  <xs:restriction base="xs:string">
   <xs:pattern value="16#[0-9a-fA-F]+#"/>
  </xs:restriction>
 </xs:simpleType>

 <xs:simpleType name="archCapabilityBitType">
  <xs:annotation>
   <xs:documentation>
    IA32_ARCH_CAPABILITIES (MSR 0x10A) bit names, see Intel SDM Vol. 4,
    Table 2-2.
   </xs:documentation>
  </xs:annotation>
  <xs:restriction base="xs:string">
   <xs:enumeration value="RDCL_NO"/>
   <xs:enumeration value="IBRS_ALL"/>
   <xs:enumeration value="SKIP_L1DFL_VMENTRY"/>
   <xs:enumeration value="SSB_NO"/>
   <xs:enumeration value="MDS_NO"/>
   <xs:enumeration value="IF_PSCHANGE_MC_NO"/>
   <xs:enumeration value="TAA_NO"/>
   <xs:enumeration value="SBDR_SSDP_NO"/>
   <xs:enumeration value="FBSDP_NO"/>
   <xs:enumeration value="PSDP_NO"/>
   <xs:enumeration value="FB_CLEAR"/>
   <xs:enumeration value="BHI_NO"/>
   <xs:enumeration value="PBRSB_NO"/>
   <xs:enumeration value="GDS_CTRL"/>
   <xs:enumeration value="GDS_NO"/>
   <xs:enumeration value="RFDS_NO"/>
   <xs:enumeration value="RFDS_CLEAR"/>
  </xs:restriction>
 </xs:simpleType>

 <xs:complexType name="mcuType">
  <xs:annotation>
   <xs:documentation>
    The \texttt{mcu} element specifies the minimum microcode revision the
    loaded update must result in. It applies uniformly to every CPU core.
   </xs:documentation>
  </xs:annotation>
  <xs:attribute name="minRevision" type="microcodeRevisionType" use="required">
   <xs:annotation>
    <xs:documentation>
     Minimum microcode revision, the loaded revision must be greater or
     equal.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
 </xs:complexType>

 <xs:complexType name="archCapabilitiesRequireType">
  <xs:annotation>
   <xs:documentation>
    A single IA32_ARCH_CAPABILITIES bit required to be set by the
    boot-time check.
   </xs:documentation>
  </xs:annotation>
  <xs:attribute name="bit" type="archCapabilityBitType" use="required">
   <xs:annotation>
    <xs:documentation>
     Name of the required bit.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
 </xs:complexType>

 <xs:complexType name="archCapabilitiesType">
  <xs:annotation>
   <xs:documentation>
    The \texttt{archCapabilities} element declares the IA32_ARCH_CAPABILITIES
    immunity and analysis bits the mitigation policy relies on. At boot, the
    kernel verifies that the post-microcode-load register value matches the
    declared expectations and panics on mismatch.
   </xs:documentation>
  </xs:annotation>
  <xs:sequence>
   <xs:element name="require" type="archCapabilitiesRequireType" minOccurs="0" maxOccurs="unbounded"/>
  </xs:sequence>
 </xs:complexType>

 <xs:complexType name="eibrsType">
  <xs:annotation>
   <xs:documentation>
    Enable the enhanced Indirect Branch Restricted Speculation (eIBRS)
    mitigation at bring-up. Writes IA32_SPEC_CTRL.IBRS = 1 once per core;
    eIBRS is sticky, so no re-apply per VM entry or exit.
   </xs:documentation>
  </xs:annotation>
  <xs:attribute name="enable" type="booleanType" use="required">
   <xs:annotation>
    <xs:documentation>
     Write IA32_SPEC_CTRL.IBRS = 1 at bring-up when true.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
 </xs:complexType>

 <xs:complexType name="ibrsLegacyType">
  <xs:annotation>
   <xs:documentation>
    Enable the legacy Indirect Branch Restricted Speculation (IBRS)
    re-assert on a CPU without eIBRS. Legacy IBRS is not sticky across the
    guest's execution, so IA32_SPEC_CTRL.IBRS = 1 is written unconditionally
    on every VM exit (before the first indirect branch of the exit path);
    there is no bring-up write.
   </xs:documentation>
  </xs:annotation>
  <xs:attribute name="enable" type="booleanType" use="required">
   <xs:annotation>
    <xs:documentation>
     Re-assert IA32_SPEC_CTRL.IBRS = 1 on every VM exit when true.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
 </xs:complexType>

 <xs:complexType name="ibpbType">
  <xs:annotation>
   <xs:documentation>
    Execute IA32_PRED_CMD.IBPB on every scheduling-partition crossing.
   </xs:documentation>
  </xs:annotation>
  <xs:attribute name="enable" type="booleanType" use="required">
   <xs:annotation>
    <xs:documentation>
     Emit the IBPB flush on partition crossing when true.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
 </xs:complexType>

 <xs:complexType name="verwType">
  <xs:annotation>
   <xs:documentation>
    Execute the VERW fill-buffer clear before VM entry.
   </xs:documentation>
  </xs:annotation>
  <xs:attribute name="enable" type="booleanType" use="required">
   <xs:annotation>
    <xs:documentation>
     Emit the VERW fill-buffer clear when true.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
 </xs:complexType>

 <xs:complexType name="l1dFlushType">
  <xs:annotation>
   <xs:documentation>
    Flush the L1 data cache (L1D) via IA32_FLUSH_CMD before VM entry.
   </xs:documentation>
  </xs:annotation>
  <xs:attribute name="enable" type="booleanType" use="required">
   <xs:annotation>
    <xs:documentation>
     Emit the L1D flush (IA32_FLUSH_CMD) on the VM-entry path when true.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
 </xs:complexType>

 <xs:simpleType name="rsbStuffingModeType">
  <xs:annotation>
   <xs:documentation>
    RSB-stuffing sequence variant.
   </xs:documentation>
  </xs:annotation>
  <xs:restriction base="xs:string">
   <xs:enumeration value="singleCall"/>
   <xs:enumeration value="fullFill32"/>
  </xs:restriction>
 </xs:simpleType>

 <xs:complexType name="rsbStuffingType">
  <xs:annotation>
   <xs:documentation>
    Stuff the Return Stack Buffer (RSB) on the VM-exit path.
   </xs:documentation>
  </xs:annotation>
  <xs:attribute name="enable" type="booleanType" use="required">
   <xs:annotation>
    <xs:documentation>
     Emit the RSB-stuffing sequence when true.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
  <xs:attribute name="mode" type="rsbStuffingModeType" use="required">
   <xs:annotation>
    <xs:documentation>
     Sequence variant: \texttt{singleCall} for an eIBRS host with the PBRSB
     bug, \texttt{fullFill32} for a non-eIBRS host.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
 </xs:complexType>

 <xs:complexType name="bhbLoopType">
  <xs:annotation>
   <xs:documentation>
    Run the Branch History Buffer (BHB) clearing loop on the VM-exit path.
   </xs:documentation>
  </xs:annotation>
  <xs:attribute name="enable" type="booleanType" use="required">
   <xs:annotation>
    <xs:documentation>
     Emit the BHB-clearing loop when true.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
 </xs:complexType>

 <xs:complexType name="bhiDisSType">
  <xs:annotation>
   <xs:documentation>
    Set the IA32_SPEC_CTRL.BHI_DIS_S bit at bring-up to mitigate Branch
    History Injection (BHI) in hardware.
   </xs:documentation>
  </xs:annotation>
  <xs:attribute name="enable" type="booleanType" use="required">
   <xs:annotation>
    <xs:documentation>
     Write IA32_SPEC_CTRL.BHI_DIS_S = 1 at bring-up when true.
    </xs:documentation>
   </xs:annotation>
  </xs:attribute>
 </xs:complexType>

 <xs:complexType name="initMitigationsType">
  <xs:annotation>
   <xs:documentation>
    Mitigations applied once per core at bring-up.
   </xs:documentation>
  </xs:annotation>
   <xs:sequence>
    <xs:element name="eibrs" type="eibrsType" minOccurs="1" maxOccurs="1"/>
    <xs:element name="bhiDisS" type="bhiDisSType" minOccurs="1" maxOccurs="1"/>
   </xs:sequence>
  </xs:complexType>

 <xs:complexType name="vmEntryMitigationsType">
  <xs:annotation>
   <xs:documentation>
    Mitigations applied on the VM-entry path.
   </xs:documentation>
  </xs:annotation>
  <xs:sequence>
   <xs:element name="ibpb" type="ibpbType" minOccurs="1" maxOccurs="1"/>
   <xs:element name="verw" type="verwType" minOccurs="1" maxOccurs="1"/>
   <xs:element name="l1dFlush" type="l1dFlushType" minOccurs="1" maxOccurs="1"/>
  </xs:sequence>
 </xs:complexType>

 <xs:complexType name="vmExitMitigationsType">
  <xs:annotation>
   <xs:documentation>
    Mitigations applied on the VM-exit path.
   </xs:documentation>
  </xs:annotation>
   <xs:sequence>
    <xs:element name="ibrsLegacy" type="ibrsLegacyType" minOccurs="1" maxOccurs="1"/>
    <xs:element name="rsbStuffing" type="rsbStuffingType" minOccurs="1" maxOccurs="1"/>
    <xs:element name="bhbLoop" type="bhbLoopType" minOccurs="1" maxOccurs="1"/>
   </xs:sequence>
  </xs:complexType>

 <xs:complexType name="mitigationsFactsType">
  <xs:annotation>
   <xs:documentation>
    The transient-execution mitigation requirements of the target CPU: the
    required microcode revision, the IA32_ARCH_CAPABILITIES bits the policy
    relies on and the per-mitigation settings of the init, vmEntry and
    vmExit paths. The platform \texttt{mitigations} override (see
    \texttt{platform}) adjusts these requirements for a specific system.
   </xs:documentation>
  </xs:annotation>
  <xs:sequence>
   <xs:element name="mcu" type="mcuType" minOccurs="1" maxOccurs="1"/>
   <xs:element name="archCapabilities" type="archCapabilitiesType" minOccurs="1" maxOccurs="1"/>
   <xs:element name="init" type="initMitigationsType" minOccurs="1" maxOccurs="1"/>
   <xs:element name="vmEntry" type="vmEntryMitigationsType" minOccurs="1" maxOccurs="1"/>
   <xs:element name="vmExit" type="vmExitMitigationsType" minOccurs="1" maxOccurs="1"/>
   </xs:sequence>
  </xs:complexType>

</xs:schema>
